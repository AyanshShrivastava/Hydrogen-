rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Shared Security Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasValidTimestampsOnCreate(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }

    function hasValidTimestampsOnUpdate(data) {
      return data.createdAt == existing().createdAt && data.updatedAt == request.time;
    }

    function isParentUserValid(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // --- Entity Validation Helpers ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'authProvider',
          'designId',
          'surfaceRadius',
          'editorFontSize',
          'layoutMode',
          'thinkingLevel',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'authProvider',
          'designId',
          'surfaceRadius',
          'editorFontSize',
          'layoutMode',
          'thinkingLevel',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid == request.auth.uid && data.uid == userId &&
        data.email is string && data.email.size() <= 320 &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.authProvider in ['password', 'google', 'other'] &&
        data.designId in ['obsidian', 'paper', 'nordic', 'monochrome'] &&
        data.surfaceRadius in ['sharp', 'balanced', 'soft'] &&
        data.editorFontSize is number && data.editorFontSize >= 12 && data.editorFontSize <= 15 &&
        data.layoutMode in ['standard', 'focus'] &&
        data.thinkingLevel in ['LOW', 'MEDIUM', 'HIGH', 'XHIGH'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceFile(data, userId) {
      return data.keys().hasAll(['ownerId', 'path', 'content', 'size', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'path', 'content', 'size', 'createdAt', 'updatedAt']) &&
        data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.path is string && data.path.size() >= 1 && data.path.size() <= 260 &&
        data.content is string && data.content.size() <= 200000 &&
        data.size is number && data.size >= 0 && data.size <= 200000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAssistantMessage(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'role',
          'content',
          'thinkingLevel',
          'toolSummary',
          'error',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'role',
          'content',
          'thinkingLevel',
          'toolSummary',
          'error',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.role in ['user', 'assistant'] &&
        data.content is string && data.content.size() <= 32000 &&
        data.thinkingLevel in ['LOW', 'MEDIUM', 'HIGH', 'XHIGH'] &&
        data.toolSummary is string && data.toolSummary.size() <= 4000 &&
        data.error is string && data.error.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMcpBookmark(data, userId, serverDocId) {
      return data.keys().hasAll([
          'ownerId',
          'serverId',
          'name',
          'description',
          'transport',
          'endpointUrl',
          'authType',
          'enabled',
          'lastStatus',
          'toolCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'serverId',
          'name',
          'description',
          'transport',
          'endpointUrl',
          'authType',
          'enabled',
          'lastStatus',
          'toolCount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId &&
        data.serverId is string && data.serverId == serverDocId && data.serverId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.description is string && data.description.size() <= 500 &&
        data.transport in ['builtin', 'http'] &&
        data.endpointUrl is string && data.endpointUrl.size() >= 1 && data.endpointUrl.size() <= 500 &&
        data.authType in ['none', 'bearer', 'api_key', 'oauth2_client_credentials', 'basic'] &&
        data.enabled is bool &&
        data.lastStatus in ['disconnected', 'connecting', 'connected', 'auth_error', 'error'] &&
        data.toolCount is number && data.toolCount >= 0 && data.toolCount <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        hasValidTimestampsOnCreate(incoming());
      allow update: if isSignedIn() &&
        isValidUserProfile(incoming(), userId) &&
        isValidId(userId) &&
        isOwner(userId) &&
        incoming().uid == existing().uid &&
        hasValidTimestampsOnUpdate(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'designId',
            'surfaceRadius',
            'editorFontSize',
            'layoutMode',
            'thinkingLevel',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'email',
            'displayName',
            'authProvider',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      match /files/{fileId} {
        allow get: if isValidId(userId) && isValidId(fileId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(fileId) &&
          isOwner(userId) &&
          isValidWorkspaceFile(incoming(), userId) &&
          hasValidTimestampsOnCreate(incoming()) &&
          isParentUserValid(userId);
        allow update: if isSignedIn() &&
          isValidWorkspaceFile(incoming(), userId) &&
          isValidId(userId) &&
          isValidId(fileId) &&
          isOwner(userId) &&
          isParentUserValid(userId) &&
          incoming().ownerId == existing().ownerId &&
          hasValidTimestampsOnUpdate(incoming()) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['content', 'size', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['path', 'content', 'size', 'updatedAt'])
          );
        allow delete: if isValidId(userId) && isValidId(fileId) && isOwner(userId);
      }

      match /messages/{messageId} {
        allow get: if isValidId(userId) && isValidId(messageId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(messageId) &&
          isOwner(userId) &&
          isValidAssistantMessage(incoming(), userId) &&
          hasValidTimestampsOnCreate(incoming()) &&
          isParentUserValid(userId);
        allow update: if isSignedIn() &&
          isValidAssistantMessage(incoming(), userId) &&
          isValidId(userId) &&
          isValidId(messageId) &&
          isOwner(userId) &&
          isParentUserValid(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().role == existing().role &&
          hasValidTimestampsOnUpdate(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'toolSummary', 'error', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(messageId) && isOwner(userId);
      }

      match /mcpServers/{serverId} {
        allow get: if isValidId(userId) && isValidId(serverId) && isOwner(userId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isSignedIn() &&
          isValidId(userId) &&
          isValidId(serverId) &&
          isOwner(userId) &&
          isValidMcpBookmark(incoming(), userId, serverId) &&
          hasValidTimestampsOnCreate(incoming()) &&
          isParentUserValid(userId);
        allow update: if isSignedIn() &&
          isValidMcpBookmark(incoming(), userId, serverId) &&
          isValidId(userId) &&
          isValidId(serverId) &&
          isOwner(userId) &&
          isParentUserValid(userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().serverId == existing().serverId &&
          hasValidTimestampsOnUpdate(incoming()) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['lastStatus', 'toolCount', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'description',
              'transport',
              'endpointUrl',
              'authType',
              'enabled',
              'lastStatus',
              'toolCount',
              'updatedAt'
            ])
          );
        allow delete: if isValidId(userId) && isValidId(serverId) && isOwner(userId);
      }
    }
  }
}
